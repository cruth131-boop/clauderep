<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline test harness. BotDir selects the bot sources (default ../bot); build variants into separate
       output/intermediate folders, e.g. -p:BotDir=/tmp/base -p:IntermediateOutputPath=obj/base/ -o out/base -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>IctGoldHarness</AssemblyName>
    <RootNamespace>IctGoldHarness</RootNamespace>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <BotDir Condition="'$(BotDir)' == ''">$(MSBuildProjectDirectory)/../bot</BotDir>
    <NoWarn>$(NoWarn);CS0067;CS0168;CS0169;CS0219;CS0414;CS0649;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(BotDir)/*.cs" />
  </ItemGroup>
</Project>
